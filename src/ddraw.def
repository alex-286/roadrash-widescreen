    DirectDrawEnumerateW=_DirectDrawEnumerateW@8
    DirectDrawEnumerateExA=_DirectDrawEnumerateExA@12
    DirectDrawEnumerateExW=_DirectDrawEnumerateExW@12
    RoadRashWidescreenVersion=_RoadRashWidescreenVersion@0
    AcquireDDThreadLock=ForwardAcquireDDThreadLock
    CompleteCreateSysmemSurface=ForwardCompleteCreateSysmemSurface
    D3DParseUnknownCommand=ForwardD3DParseUnknownCommand
    DDGetAttachedSurfaceLcl=ForwardDDGetAttachedSurfaceLcl
    DDInternalLock=ForwardDDInternalLock
    DDInternalUnlock=ForwardDDInternalUnlock
    DSoundHelp=ForwardDSoundHelp
    DirectDrawCreateClipper=ForwardDirectDrawCreateClipper
    DllCanUnloadNow=ForwardDllCanUnloadNow PRIVATE
    DllGetClassObject=ForwardDllGetClassObject PRIVATE
    GetDDSurfaceLocal=ForwardGetDDSurfaceLocal
    GetOLEThunkData=ForwardGetOLEThunkData
    GetSurfaceFromDC=ForwardGetSurfaceFromDC
    RegisterSpecialCase=ForwardRegisterSpecialCase
    ReleaseDDThreadLock=ForwardReleaseDDThreadLock
    SetAppCompatData=ForwardSetAppCompatData
